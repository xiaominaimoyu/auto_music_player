+class TestDirectOverrideSemitoneGuard(unittest.TestCase):
+    """带半音的音必须绕开物理直达键,否则会被弹成自然音。"""
+
+    def _params(self):
+        from core.compiler import Modifier
+        return CompileParams(
+            bpm=100, pitch_keys=("Z", "X", "C", "V", "B", "N", "M"),
+            modifier_buttons={Modifier.LOWER: "left", Modifier.SEMITONE: "middle",
+                              Modifier.HIGHER: "right"},
+            pitch_direct_overrides={"high_1": ","},
+            hold_ratio=1.0, gap_ms=0.0,
+            modifier_policy=ModifierPolicy.OCTAVE_FIRST,
+            chord_policy=ChordPolicy.CHORD_FIRST,
+        )
+
+    def test_natural_uses_override(self):
+        res = compile_score([IRNote(1, 1, 0)], self._params())
+        self.assertIn((",", "down"), [(e.key, e.action) for e in res.events])
+        self.assertNotIn(("right", "down"), [(e.key, e.action) for e in res.events])
+
+    def test_semitone_skips_override(self):
+        res = compile_score([IRNote(1, 1, 1)], self._params())
+        keys = [(e.device, e.key, e.action) for e in res.events]
+        self.assertNotIn((",", "down"), [(k, a) for _, k, a in keys])
+        self.assertIn(("mouse", "right", "down"), keys, "带半音应走右键(高八度)修饰路径")
+
+    def test_semitone_direct_override_via_event_plan(self):
+        """端到端:delta 档位下 high_1# 不得命中 ',' 直达键。"""
+        plan, _ = build_event_plan([{"notes": ["high_1"], "dur": 1.0, "semitone": 1}],
+                                   _delta(), "free_play", **KW)
+        sig = _sig(plan.events)
+        self.assertNotIn((",", "down"), [(k, a) for _, k, a in sig])
+        self.assertIn(("mouse", "right", "down"), sig)
+
