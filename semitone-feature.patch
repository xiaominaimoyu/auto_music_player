--- /dev/null
+++ b/tests/test_semitone.py
@@ -0,0 +1,135 @@
+"""回归测试:半音(# 升半音)链路与直达键守卫。
+
+覆盖本次补丁的三处改动:
+  1. core/parser.py   简谱 `#` 升半音标记 → 存储项的可选字段 semitone
+  2. core/ir.py       存储项 semitone 字段 ↔ IR 的双向承载(且不写进 note_id)
+  3. core/compiler.py 带半音的音不得走物理直达键(否则绕过高八度修饰键)
+  4. config.yaml      player.countdown_seconds 可配置
+
+这些用例不依赖真实游戏与真实 SendInput。
+"""
+
+import os
+import unittest
+
+import yaml
+
+from core.compiler import ChordPolicy, CompileParams, ModifierPolicy, compile_score
+from core.ir import IRNote, from_storage, to_storage
+from core.parser import parse_jianpu
+from core.profile import load_profiles
+from gui.player_tab import build_event_plan
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+PROFILES_DIR = os.path.join(REPO_ROOT, "profiles")
+LEGACY_KEYMAP = {"high": list("QWERTYU"), "mid": list("ASDFGHJ"), "low": list("ZXCVBNM")}
+KW = dict(bpm=100, settle_ms=30.0, release_settle_ms=20.0, hold_ratio=1.0, gap_ms=0.0)
+
+
+def _delta():
+    return [p for p in load_profiles(PROFILES_DIR, fallback_keymap=LEGACY_KEYMAP)
+            if p.id == "delta_force_harmonica"][0]
+
+
+def _sig(events):
+    return [(e.device, e.key, e.action) for e in events]
+
+
+class TestParserSharp(unittest.TestCase):
+    def test_sharp_marks_semitone(self):
+        r = parse_jianpu("1# 2 3,# 4'")
+        self.assertEqual([n.get("semitone", 0) for n in r], [1, 0, 1, 0])
+        self.assertEqual([n["notes"][0] for n in r],
+                         ["mid_1", "mid_2", "low_3", "high_4"])
+
+    def test_sharp_with_duration_suffix(self):
+        r = parse_jianpu("1#_ 5'#-")
+        self.assertEqual((r[0]["semitone"], r[0]["dur"]), (1, 0.5))
+        self.assertEqual((r[1]["semitone"], r[1]["dur"]), (1, 2.0))
+
+    def test_natural_note_has_no_semitone_field(self):
+        """自然音不写该字段:旧库与安卓端读到的 JSON 与历史完全一致。"""
+        for item in parse_jianpu("1 2 3 4 5 6 7"):
+            self.assertNotIn("semitone", item)
+
+    def test_sharp_in_chord_marks_item(self):
+        """和弦内任一音带 # 时,整个和弦项标记为半音(降级取首音才不会丢信息)。"""
+        r = parse_jianpu("[1 3# 5]-")
+        self.assertEqual(r[0]["notes"], ["mid_1", "mid_3", "mid_5"])
+        self.assertEqual(r[0]["semitone"], 1)
+
