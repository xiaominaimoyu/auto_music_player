+class TestIRSemitone(unittest.TestCase):
+    def test_note_id_excludes_semitone(self):
+        """D1:note_id 永不含半音(半音走独立字段)。"""
+        self.assertEqual(IRNote(3, 0, 1).note_id, "mid_3")
+        self.assertEqual(IRNote(1, 1, 0).note_id, "high_1")
+
+    def test_field_roundtrip(self):
+        ir = from_storage([{"notes": ["low_1"], "dur": 0.5, "semitone": 1}])
+        self.assertEqual((ir[0].octave, ir[0].pitch, ir[0].semitone), (-1, 1, 1))
+        self.assertEqual(to_storage(ir), [{"notes": ["low_1"], "dur": 0.5, "semitone": 1}])
+
+    def test_natural_storage_unchanged(self):
+        """自然音的落盘 JSON 与历史完全一致(不新增字段)。"""
+        ir = from_storage([{"notes": ["mid_3"], "dur": 1.0}])
+        self.assertEqual(to_storage(ir), [{"notes": ["mid_3"], "dur": 1.0}])
+
+    def test_explicit_semitones_argument_wins(self):
+        ir = from_storage([{"notes": ["low_1"], "dur": 1.0, "semitone": 1}], semitones=[0])
+        self.assertEqual(ir[0].semitone, 0)
+
+    def test_invalid_field_raises(self):
+        for bad in (2, -1, "1", True):
+            with self.assertRaises(ValueError):
+                from_storage([{"notes": ["mid_1"], "dur": 1.0, "semitone": bad}])
+
+    def test_length_mismatch_raises(self):
+        with self.assertRaises(ValueError):
+            from_storage([{"notes": ["mid_1"], "dur": 1.0}], semitones=[1, 0])
+
